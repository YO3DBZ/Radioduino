{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/~/Arduino/libraries/**",
        "${workspaceFolder}/~/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "${workspaceFolder}/~/.arduino15/packages/arduino/hardware/avr/1.8.8/variants/eightanaloginputs",
        "${workspaceFolder}/~/.arduino15/packages/arduino/hardware/avr/1.8.8/libraries/Wire/src",
        //"/usr/avr/include"
      ],
      "forcedInclude": [
        "${workspaceFolder}/~/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino/Arduino.h"
      ],
      "defines": [
        "F_CPU=16000000L",
        "ARDUINO=10808",
        "ARDUINO_AVR_NANO",
        "ARDUINO_ARCH_AVR",
        "__AVR_ATmega328P__"
      ],
      "compilerPath": "/usr/bin/avr-gcc",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
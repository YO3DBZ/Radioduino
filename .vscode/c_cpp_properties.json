{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/Arduino/libraries/**",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard",
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/libraries/**",
        "${env:HOME}/.arduino15/packages/arduino/tools/avr-gcc/**/avr/include"
      ],
      "forcedInclude": [
        "${env:HOME}/.arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino/Arduino.h"
      ],
      "defines": [
        "F_CPU=16000000L",
        "ARDUINO=10808",
        "ARDUINO_AVR_NANO",
        "ARDUINO_ARCH_AVR",
        "UBRRH"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "gnu++14",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}